# Salin menjadi .env. Jangan diunggah (berisi kredensial).
PORT=3000
DEVICE_CODE=dispenser-001
MQTT_TOPIC_PREFIX=dispenser/001

# MySQL XAMPP (default: root tanpa password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_water

# Broker MQTT.
#  - Uji lokal tanpa internet : mqtt://127.0.0.1:1883   (jalankan `npm run broker`)
#  - EMQX Cloud Serverless    : mqtts://<host>.emqxsl.com:8883  + username/password di bawah
#  - Kosong = MQTT nonaktif (API + dashboard tetap jalan)
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Opsional
# FRESH_SEC=30
# TARE_TIMEOUT_SEC=60
# RATE_LIMIT_PER_MIN=10

